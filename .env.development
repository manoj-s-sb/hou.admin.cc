REACT_APP_API_BASE_URL=https://sbcc-func-auth-dev.azurewebsites.net
REACT_APP_ENV=development
# Centre Management runs against its own local backend (other modules stay on the URL above).
# Comment out to make centre calls use REACT_APP_API_BASE_URL instead.
REACT_APP_CENTRES_API_BASE_URL=http://localhost:7071

# Membership Plans backend (same local host as Centre Management).
# Falls back to REACT_APP_CENTRES_API_BASE_URL if unset.
REACT_APP_MEMBERSHIPS_API_BASE_URL=http://localhost:7071
